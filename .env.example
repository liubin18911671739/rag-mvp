# Database Configuration
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# Ollama Configuration
OLLAMA_URL=http://ollama:11434
# Or use local Ollama: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_PORT=11434

# Embedding Model
EMBED_MODEL_PATH=/models/bge-m3
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=32

# Text Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# Retrieval
TOP_K=5
SCORE_THRESHOLD=0.5

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# UI Configuration
UI_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
